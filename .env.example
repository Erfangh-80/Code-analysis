# Required trust boundary and API token. Do not commit a real value.
ANALYZER_REPO_ROOT=/absolute/path/to/allowed-repositories
ANALYZER_API_TOKEN=replace-with-a-long-random-token

# Optional server settings
ANALYZER_LISTEN_ADDR=127.0.0.1:8080
ANALYZER_DATA_DIR=./data
ANALYZER_MAX_FILE_BYTES=2097152
ANALYZER_MAX_COMMITS=5000
ANALYZER_ANALYSIS_TIMEOUT=10m
# ANALYZER_WEB_DIR=./frontend/out
# ANALYZER_ALLOWED_ORIGINS=http://localhost:3000
# ANALYZER_TLS_CERT=/secure/path/cert.pem
# ANALYZER_TLS_KEY=/secure/path/key.pem
